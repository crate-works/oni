{
  "name": "oni",
  "version": "0.0.0",
  "description": "Discovery portal for browsing research data described as RO-Crate.",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:paradisec-stage",
    "dev:paradisec-stage": "vite --mode paradisec-stage",
    "dev:paradisec": "vite --mode paradisec",
    "dev:ldaca-dev": "vite --mode ldaca-dev",
    "dev:ldaca": "echo 'Coming soon'",
    "dev:local": "vite --mode local-config",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:biome": "biome check .",
    "lint:types": "vue-tsc --build",
    "lint:knip": "knip",
    "setup:vocabs": "scripts/fetch-vocabs.mts",
    "docker:test": "sh docker/test.sh",
    "postinstall": "pnpm run setup:vocabs vocab.json"
  },
  "keywords": [
    "Oni",
    "UI",
    "Discovery",
    "Portal"
  ],
  "author": "Moises Sacal",
  "license": "GPL-3.0",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@gtm-support/vue-gtm": "^3.2.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@sentry/vue": "^10.75.2",
    "@tailwindcss/vite": "^4.3.3",
    "@terraformer/wkt": "^2.2.2",
    "@unhead/vue": "^3.4.1",
    "@vue/devtools-api": "^8.2.1",
    "element-plus": "^2.14.6",
    "fuse.js": "^7.5.0",
    "latlon-geohash": "^2.0.0",
    "leaflet": "^1.9.4",
    "leaflet-editable": "^1.3.2",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet.path.drag": "^0.0.6",
    "manku-icon-lib": "^1.1.7",
    "oidc-client-ts": "^3.5.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ro-crate": "^3.7.2",
    "vue": "^3.5.43",
    "vue-cookies": "^1.8.6",
    "vue-i18n": "^11.4.12",
    "vue-pdf-embed": "^2.1.6",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/latlon-geohash": "^2.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/terraformer__wkt": "^2.0.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "jsdom": "^30.1.1",
    "knip": "^6.37.0",
